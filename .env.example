# Local development settings. Keep production values out of this file and set
# them as environment variables on the host instead.
#
#   cp .env.example .env
#
# SECRET_KEY is mandatory; generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"

SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave USE_DATABASE_URL=False and DATABASE_URL empty to use the bundled
# SQLite db.sqlite3. Both are required to target a hosted Postgres, e.g.
#   USE_DATABASE_URL=True
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
USE_DATABASE_URL=False
DATABASE_URL=

# Supabase Storage (S3-compatible). Leave blank to store uploads in media/.
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_BUCKET=images
SUPABASE_S3_ENDPOINT_URL=

# Production only
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
